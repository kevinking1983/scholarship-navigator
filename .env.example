# ---- TinyFish (required for live mode) --------------------------------------
# Get a key at https://agent.tinyfish.ai/api-keys
TINYFISH_API_KEY=your_key_here

# ---- Modes ------------------------------------------------------------------
# MOCK=1        force sample data even when a key is present (demo-day safety net)
# DEMO_REPLAY=1 replay demo/replay_snapshot.json with realistic delays (no network, no credits)
# DEMO_RECORD=1 while live: save the next discovery run to demo/replay_snapshot.json
MOCK=0
DEMO_REPLAY=0
DEMO_RECORD=0
DEMO_REPLAY_SPEED=1

# ---- Credit protection ------------------------------------------------------
TOP_K=6                 # max Agent extraction runs per discovery (each costs credits)
EXTRACT_WORKERS=4       # parallel Agent runs
RETRY_THIN_EXTRACTION=0 # 1 = run a second, narrower Agent goal when a page came back mostly empty
CACHE=1                 # disk cache in .cache/ (24h TTL, hashed keys, scholarship data only)
CACHE_TTL_SECONDS=86400

# ---- Deploy -----------------------------------------------------------------
# Public URL of this app once deployed (TinyFish's cloud browser cannot reach localhost)
PUBLIC_BASE_URL=
PORT=8000
